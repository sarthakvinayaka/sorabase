{
  "name": "sorabase-desktop",
  "productName": "Sorabase",
  "version": "0.1.0",
  "description": "Capture meeting audio without a bot — Granola-style system audio capture",
  "author": "Sorabase",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "npm run build && electron .",
    "dev": "node esbuild.config.mjs && electron . --dev",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:all": "npm run build && electron-builder --mac --win --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "build": {
    "appId": "org.sorabase.desktop",
    "productName": "Sorabase",
    "copyright": "Copyright © 2025 Sorabase",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/tray-template.png",
      "assets/tray-rec-template.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": null,
      "gatekeeperAssess": false,
      "protocols": [
        { "name": "Sorabase", "schemes": ["sorabase"] }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "assets/icon.ico",
      "shortcutName": "Sorabase"
    },
    "publish": {
      "provider": "github",
      "owner": "sarthakvinayaka",
      "repo": "sorabase"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
